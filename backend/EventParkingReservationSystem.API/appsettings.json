{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EventParkingReservationDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Booking": {
    "HoldDurationMinutes": 15
  },

  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_DEVELOPMENT_SECRET_KEY_123456789",
    "Issuer": "EventParkingReservationSystem.API",
    "Audience": "EventParkingReservationSystem.Angular",
    "ExpiryMinutes": 60,
    "RememberMeExpiryDays": 7
  },

  "Auth": {
    "EmailVerificationExpiryHours": 24,
    "PasswordResetExpiryMinutes": 60
  },

  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "EventFlow"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
  {
    "ticketPrice": 5000,
    "childDiscountPercent": 50
  }
  {
    "hasBookings": true,
    "canEditTicketPrice": false,
    "canEditCapacity": false,
    "canEditStageLayout": false,
    "canDelete": false
  }
}
{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EventParkingReservationDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Booking": {
    "HoldDurationMinutes": 15
  },

  "Jwt": {
    "Issuer": "EventParkingReservationSystem.API",
    "Audience": "EventParkingReservationSystem.Angular",
    "CustomerAccessTokenExpirationMinutes": 30,
    "AdminAccessTokenExpirationMinutes": 15,
    "CustomerRefreshTokenExpirationDays": 7,
    "RememberMeRefreshTokenExpirationDays": 30,
    "AdminRefreshTokenExpirationDays": 1,
    "ExpiryMinutes": 30,
    "RememberMeExpiryDays": 30
  },

  "Auth": {
    "EmailVerificationExpiryHours": 24,
    "PasswordResetExpiryMinutes": 60
  },

  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "BookWithUs"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}